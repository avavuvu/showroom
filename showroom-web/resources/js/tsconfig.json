{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["vite/client"],
        "strict": true,
        "jsx": "preserve",
        "jsxImportSource": "vue",
        "baseUrl": ".",
        "paths": {
            "@bq/*": ["../../../../../dev/boutique/*", "../../node_modules/boutique/*"],
            "@setups": ["../../bindings/setups.ts"]
        }
