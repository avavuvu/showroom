{
    "name": "showroom-rs",
    "private": true,
    "type": "module",
    "scripts": {
        "dev:js": "concurrently -n vite,dx -c cyan,yellow \"vite build --watch\" \"~/.cargo/bin/dx serve --hot-patch --features local --package showroom-web\"",
        "build": "vite build",
        "setups": "cargo check -q -p showroom-web",
        "setups:check": "npm run setups && git diff --exit-code -- bindings && test -z \"$(git ls-files --others --exclude-standard -- bindings)\"",
        "dev": "~/.cargo/bin/dx serve --hot-patch --features local --package showroom-web"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.7",
        "boutique": "github:avavuvu/boutique#8868412b0d872abd3fa6aa77642dead926cb9f10",
        "concurrently": "^10.0.3",
        "typescript": "~6.0.3",
        "vite": "^7.3.3"
    },
    "dependencies": {
        "@tiptap/extension-image": "3.27.1",
        "@tiptap/extension-underline": "^3.27.1",
        "@tiptap/starter-kit": "^3.27.1",
        "@tiptap/vue-3": "^3.27.1",
        "@vueuse/core": "^14.3.0",
        "lucide-vue-next": "^1.0.0",
        "vue": "^3.5.38"
    }
}
